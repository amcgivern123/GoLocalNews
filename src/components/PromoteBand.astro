---
import { SITE } from '../lib/site';
---
<section class="band-dark" aria-labelledby="promote-h">
  <div class="band-text">
    <h2 id="promote-h">Run a local business? Tell us your news.</h2>
    <p>Openings, anniversaries, new staff, special offers: send it in and we'll help you reach customers across {SITE.town}.</p>
  </div>
  <div class="band-actions">
    <a class="btn btn-accent" href="/submit/">Submit a story</a>
    <a class="btn btn-outline" href="/submit/?type=offer">List an offer</a>
  </div>
</section>
