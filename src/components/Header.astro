---
import { SITE, CATEGORIES } from '../lib/site';
import Wordmark from './Wordmark.astro';

const today = new Date().toLocaleDateString('en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/London',
});
const path = Astro.url.pathname;
const links = [
  { href: '/latest/', label: 'Latest' },
  { href: '/offers/', label: 'Offers' },
  ...Object.entries(CATEGORIES).map(([slug, label]) => ({ href: `/category/${slug}/`, label })),
];
---
<div class="topbar">
  <div class="container">
    <span>{today}</span>
    <nav aria-label="Quick links">
      <a href="/#newsletter">Free weekly newsletter</a>
      <a href="/advertise/">Advertise</a>
      <a href="/submit/"><strong>Submit your news</strong></a>
    </nav>
  </div>
</div>
<header class="masthead">
  <div class="container">
    <div>
      <a class="logo" href="/" aria-label={`${SITE.name} home`}>
        <img class="logo-icon" src={SITE.brand.icon} alt="" width="48" height="48" />
        <span class="logo-text"><Wordmark /></span>
      </a>
      <p class="tagline">{SITE.tagline}</p>
    </div>
    <a class="btn btn-accent" href="/submit/">Get your business featured</a>
  </div>
</header>
<nav class="mainnav container" aria-label="Sections">
  <ul>
    {links.map((l) => (
      <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
    ))}
  </ul>
</nav>
