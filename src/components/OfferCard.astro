---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/site';

interface Props { offer: CollectionEntry<'offers'> }
const { business, offer, area, ends, link, details } = Astro.props.offer.data;
---
<article class="offer">
  {area && <span class="offer-area">{area}</span>}
  <h3>{link ? <a href={link} rel="noopener">{business}</a> : business}</h3>
  <p class="offer-deal">{offer}</p>
  {details && <p style="margin:0;font-size:15px">{details}</p>}
  <span class="meta">Ends {formatDate(ends)}</span>
</article>
