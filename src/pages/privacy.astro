---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---
<BaseLayout title="Privacy" description={`How ${SITE.name} handles your information.`}>
  <div class="page">
    <h1>Privacy</h1>
    <p>[YOUR PRIVACY POLICY: what you collect (newsletter emails, story submissions), why, how long you keep it, and how people can ask for it to be deleted. Your business name and contact address go here.]</p>
  </div>
</BaseLayout>
